{
  "name": "mysubs-nomina",
  "version": "1.0.0",
  "description": "Sistema Empresarial de Nómina, Roles de Pago y Cuadro de Remuneraciones para MYSUBS",
  "main": "electron-main.cjs",
  "scripts": {
    "start": "node server/index.js",
    "seed": "node server/database/seed.js",
    "test": "node server/tests/test_suite.js",
    "test:flow": "node server/tests/payment_flow.cjs",
    "build": "npm --prefix client install && npm --prefix client run build",
    "build:client": "npm --prefix client run build",
    "build:app": "npm run build:client && node scripts/prepare-desktop.cjs && electron-builder --win",
    "dist": "npm run build:app",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "node server/index.js",
    "desktop": "electron .",
    "test:payroll": "node server/tests/payroll_features.cjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.mysubs.nomina",
    "productName": "MYSUBS Nomina",
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "files": [
      "electron-main.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "server",
        "to": "server"
      },
      {
        "from": "client/dist",
        "to": "client/dist"
      },
      {
        "from": "node_modules",
        "to": "node_modules"
      },
      {
        "from": "packaged-node.exe",
        "to": "node.exe"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "MYSUBS-Nomina-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
